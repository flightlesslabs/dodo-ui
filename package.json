{
  "name": "dodo-ui",
  "version": "0.1.1",
  "scripts": {
    "dev": "pnpm --filter @documentation/docs dev",
    "build": "pnpm -r build",
    "build:documentation": "pnpm --filter @documentation/* build",
    "build:packages": "pnpm --filter @flightlesslabs/* build",
    "build:i": "pnpm i && pnpm build:packages",
    "test": "pnpm -r test",
    "check": "pnpm --filter @flightlesslabs/* check",
    "check:fix": "pnpm --filter @flightlesslabs/* check:fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/sveltekit": "^10.5.10",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-svelte": "^3.23.0",
    "file-saver": "^2.0.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.24",
    "sass": "^1.103.1",
    "storybook": "^10.5.10",
    "svelte-check": "^4.7.6",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
